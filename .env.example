# VYHIR LOCAL DEVELOPMENT ENVIRONMENT

# PostgreSQL
POSTGRES_DB=vyhir_dev
POSTGRES_USER=vyhir
POSTGRES_PASSWORD=vyhir_local_dev_change_me

# Application
NODE_ENV=development

# API
# At least 32 characters; the API refuses to start otherwise. Generate: openssl rand -hex 32
JWT_SECRET=generate_a_secure_random_64_character_hex_secret_here
# Optional separate key for refresh tokens (derived from JWT_SECRET when unset)
# JWT_REFRESH_SECRET=
# Self-service organization sign-up (POST /auth/register). Keep off in production.
ALLOW_REGISTRATION=false
# Proxy hops in front of the API (LiteSpeed/Passenger = 1)
TRUST_PROXY_HOPS=1
# Password-reset emails (cPanel mailbox). Forgot-password is disabled when unset.
# SMTP_HOST=mail.yecindia.com
# SMTP_PORT=465
# SMTP_USER=no-reply@yecindia.com
# SMTP_PASS=
# SMTP_FROM="YEC ERP <no-reply@yecindia.com>"

# Production: only these browser origins may call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
API_INTERNAL_URL=http://api:3001/api/v1
